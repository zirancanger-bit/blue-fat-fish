{
  "name": "fin-desktop-pet",
  "type": "module",
  "version": "1.2.0",
  "description": "蓝色大肥鱼 · 圆手、鲸尾与一点点害羞",
  "main": "app/main.cjs",
  "author": "荆棘 & Astra",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "node scripts/package-local.mjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "three": "0.186.0"
  },
  "build": {
    "appId": "local.fin.whalepet",
    "productName": "蓝色大肥鱼",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**",
      "dist/**",
      "assets/icons/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Blue-Fat-Fish-${version}-${arch}.${ext}",
      "icon": "assets/icons/fin.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "compression": "normal"
  }
}
